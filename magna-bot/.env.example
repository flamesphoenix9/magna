# Network
RPC_URLS=https://ethereum-rpc.example,https://base-rpc.example

# Services
OPENSEA_API_KEY=replace-with-your-opensea-api-key
DATABASE_URL=postgresql://user:password@localhost:5432/magna
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_AUTHORIZED_CHAT_IDS=123456789,-987654321

# Security
# Use a 32-byte or longer secret; never commit the real value.
WALLET_ENCRYPTION_KEY=replace-with-a-32-byte-or-longer-random-secret

# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
